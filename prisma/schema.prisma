// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  monitors Monitor[]

  @@map("users")
}

model Monitor {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  url                  String
  name                 String
  active               Boolean   @default(true)
  intervalSeconds      Int       @default(10) @map("interval_seconds")

  expectedStatusCode   Int       @default(200) @map("expected_status_code")
  maxLatencyMs         Int       @default(5000) @map("max_latency_ms")
  consecutiveFailures  Int       @default(0) @map("consecutive_failures")
  isDown               Boolean   @default(false) @map("is_down")
  lastCheckedAt        DateTime? @map("last_checked_at")

  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pingResults PingResult[]
  incidents   Incident[]

  @@index([userId])
  @@index([active])
  @@index([isDown])
  @@map("monitors")
}

model PingResult {
  id            String    @id @default(uuid())
  monitorId     String    @map("monitor_id")
  statusCode    Int?      @map("status_code")
  latencyMs     Int?      @map("latency_ms")
  success       Boolean
  errorMessage  String?   @map("error_message")
  createdAt     DateTime  @default(now()) @map("created_at")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, createdAt])
  @@index([createdAt])
  @@map("ping_results")
}

model Incident {
  id                 String    @id @default(uuid())
  monitorId           String    @map("monitor_id")
  startedAt          DateTime  @default(now()) @map("started_at")
  resolvedAt         DateTime? @map("resolved_at")
  notificationStatus String    @default("pending") @map("notification_status")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId])
  @@index([startedAt])
  @@map("incidents")
}
